# AIArtha - shared environment
# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored; do not commit it.

# --- payment gateway (test mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI model provider ---
SARVAM_API_KEY=

# --- database ---
DATABASE_URL=sqlite:///./aiartha.db

# --- execution safety ---
# true: recovery actions are sent automatically
# false: decisions are queued and need human approval via the dashboard
AUTO_EXECUTE=true
ACTION_RETRY_ATTEMPTS=2
MAX_EVENTS_PER_IP_PER_MINUTE=120

# --- AI model behaviour ---
LLM_TIMEOUT_SECONDS=30.0
LLM_CACHE_CAPACITY=200
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_SECONDS=60

# --- simulation + drift ---
SIMULATION_SEED=11
DRIFT_WINDOW_EVENTS=30
DRIFT_THRESHOLD_PCT=15.0

# --- ops ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000